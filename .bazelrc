build --cxxopt=-std=c++17
build --workspace_status_command="bash ./bazel/workspace_status.sh"
build --cxxopt=-Wextra
build --cxxopt=-fsigned-char
build --cxxopt=-fno-common
build --linkopt=-rdynamic
build --cxxopt=-fPIC
build --cxxopt=-g3
build --cxxopt=-Wno-redundant-move

build --copt=-Wno-float-equal
build --copt=-Wno-unused-variable
build --copt=-Wno-unused-parameter
build --copt=-Wno-unused-function
build --copt=-Wno-missing-field-initializers
build --copt=-Wno-implicit-fallthrough

build:debug --cxxopt=-ggdb
build:debug --cxxopt=-O0
build:debug --cxxopt=-ftrapv
build:debug --cxxopt=-fstack-check
build:debug --cxxopt=-DDEBUG

build:release --cxxopt=-O2
build:release --cxxopt=-fstack-protector-strong
build:release --linkopt=-Wl,-z,relro
build:release --linkopt=-Wl,-z,now
build:release --linkopt=-Wl,-z,noexecstack
build:release --cxxopt=-D_FORTIFY_SOURCE=2
build:release --cxxopt=-DNDEBUG
build:release --linkopt=-Wl,--build-id=none
build:jeprof --define=enable_jemalloc_prof=true
build:urma --define=enable_urma=true
build:urma --copt=-DUSE_URMA
build:urma --copt=-DURMA_OVER_UB

# URMA package download mode (uncomment to download the URMA SDK package instead
# of relying on a system-installed /usr/lib64/liburma.so).
# When commented out, the urma_pkg_repository rule falls back to /usr/include.
# build:urma --repo_env=URMA_PKG_URL=<url>
# build:urma --repo_env=URMA_PKG_SHA256=<sha256>

# URMA mock backend: dev/CI without liburma.so / RDMA hardware
# Provides a local shm+TCP transport so urma_manager.cpp can be unit-tested.
# Mutually exclusive with build:urma (the actual SDK backend).
build:urma_mock --define=enable_urma_mock=true
build:urma_mock --copt=-DUSE_URMA
build:urma_mock --copt=-DUSE_URMA_MOCK

build:pipeline_h2d --config=urma
build:pipeline_h2d --define=enable_pipeline_h2d=true
build:pipeline_h2d --copt=-DBUILD_PIPLN_H2D

build:pipeline_h2d_mock --config=urma_mock
build:pipeline_h2d_mock --define=enable_pipeline_h2d=true
build:pipeline_h2d_mock --define=mock_mode=true
build:pipeline_h2d_mock --copt=-DBUILD_PIPLN_H2D

build:asan --copt=-fsanitize=address
build:asan --copt=-fno-omit-frame-pointer
build:asan --copt=-g3
build:asan --linkopt=-fsanitize=address
build:asan --define=asan=1
# Disable ASan instrumentation on brpc's bthread/context.cpp.
#
# brpc's `src/bthread/context.cpp` is a pure inline-assembly TU (one giant
# `__asm(...)` block per supported arch, defining `bthread_jump_fcontext`
# and `bthread_make_fcontext`). On aarch64 GCC emits an ASan module-init
# constructor into `.init_array` whose relocation targets a local symbol
# that the linker then discards together with its hosting section,
# producing at link time:
#   bthread/context.pic.o(.init_array.00099+0x0): error: relocation refers
#   to local symbol "" [N], which is defined in a discarded section
# This is a known ASan + aarch64 + assembly-only-fiber-context TU issue;
# the file contains no C/C++ stack frames, globals, or heap access, so ASan
# has nothing to instrument. Disabling ASan on this single file is both
# safe and sufficient.
#
# The regex `external/.*bthread/context\.cpp` (rather than a repo-name-pinned
# `external/com_github_apache_brpc/.*...`) is intentional: brpc 1.15.0 is
# registered under TWO external repo names in this workspace. The main
# build uses `@com_github_apache_brpc` (from `bazel/sdk/repositories.bzl`
# `setup_brpc` default name), but `bazel/sdk/workspace.bzl`'s
# `datasystem_source_sdk` rule declares a `repo_mapping` that re-exposes
# brpc as `@ds_brpc` inside the `@datasystem_sdk_validation` source SDK
# repository (`bazel/sdk/deps.bzl:34` calls `setup_brpc(name="ds_brpc")`).
# Both instances emit the same `src/bthread/context.cpp` and both hit the
# same `.init_array.00099` link error; pinning the regex to one repo name
# would let the other repo's link silently regress (as observed when the
# first attempt of this fix only matched `com_github_apache_brpc` and the
# SDK-validation target `@@datasystem_sdk_validation//bazel/sdk:
# client_build_validation` still failed). The broad pattern also covers any
# future brpc repo_mapping additions without further edits.
#
# The CMake build path does not need the equivalent because
# `cmake/external_libs/brpc.cmake` builds brpc with `THIRDPARTY_SAFE_FLAGS`
# (which excludes `SANITIZER_FLAGS`), so brpc is never ASan-instrumented
# under CMake; only the Bazel path applies `-fsanitize=address` globally.
build:asan --per_file_copt=external/.*bthread/context\.cpp@-fno-sanitize=address
test:asan --test_env=ASAN_OPTIONS=detect_leaks=0:detect_odr_violation=0
test:asan --test_env=LSAN_OPTIONS=detect_leaks=0

build:tsan --copt=-fsanitize=thread
build:tsan --copt=-g3
build:tsan --linkopt=-fsanitize=thread
build:tsan --define=tsan=1

# ThreadSanitizer policy for this repo:
#   - Known-benign third-party (brpc / bthread) init-time and M:N-scheduler
#     races are silenced by COMPILED-IN defaults from
#     //tools/tsan:default_suppressions, linked into datasystem_worker,
#     datasystem_coordinator, and every ds_cc_test target. See
#     tools/tsan/brpc_suppressions.txt for the same entries with full
#     justification.
#   - TSAN's default halt_on_error=1 is INTENTIONALLY preserved so that
#     any REAL race in datasystem::* code still aborts the test/binary.
#   - Operators who need to add more suppressions can extend the
#     compiled-in baseline at runtime:
#       TSAN_OPTIONS=suppressions=<path>/extra_suppressions.txt
#     TSAN merges env-supplied suppressions on top of the compiled-in ones,
#     it does not replace them.

# UBSan policy:
#   - `-fno-sanitize=alignment`: known false positives on aligned-but-not-declared-aligned third-party code.
#   - `--per_file_copt=external/.*@-fno-sanitize=undefined`: disable UBSan instrumentation on every
#     external repository (absl, grpc, rocksdb, ...). This is a compiler-version-independent
#     workaround for the GCC 14 + absl `raw_hash_set` bug where `-fsanitize=undefined` (specifically
#     the `function` sub-check) injects non-constant instrumentation around function-pointer
#     comparisons and breaks `constexpr` evaluation
#     (`absl/container/internal/hash_policy_traits.h`: `get_hash_slot_fn<Hash>() == nullptr`
#     -> "is not a constant expression"). The previous approach of adding
#     `-fno-sanitize=function` is rejected by GCC versions that do not recognize the `function`
#     sub-check name. Disabling UBSan on third-party deps is intentional: UBSan is meant to catch
#     bugs in `datasystem::*` code, not to re-validate well-tested libraries.
#   - `--per_file_copt=third_party/protos/etcd/.*@-fno-sanitize=undefined`: disable UBSan on the
#     etcd proto grpc-generated stubs (`rpc.grpc.pb.cc`, `v3election.grpc.pb.cc`). With UBSan
#     `vptr` enabled on these stubs, GCC emits additional references in `.data.rel` to
#     `typeinfo for grpc::internal::ClientReactor` (declared in
#     `include/grpcpp/support/client_callback.h` with `virtual ~ClientReactor() = default`, i.e. no
#     key function). Because grpc itself is not UBSan-instrumented (see above), and
#     `ClientReactor` has no key function, GCC's `vptr` path expects the typeinfo to be emitted by
#     the class's defining TU and does not emit it as a weak/comdat symbol in the stubs, producing
#     `undefined reference to 'typeinfo for grpc::internal::ClientReactor'` at link time. Disabling
#     UBSan on the etcd stubs restores the normal weak-symbol typeinfo emission path.
#   - Linker still links libubsan so ubsan-instrumented `datasystem::*` code is checked at runtime.
build:ubsan --cxxopt=-fsanitize=undefined
build:ubsan --cxxopt=-fno-sanitize=alignment
build:ubsan --cxxopt=-fsanitize=float-cast-overflow
build:ubsan --cxxopt=-fno-sanitize-recover=all
build:ubsan --cxxopt=-O0
build:ubsan --linkopt=-fsanitize=undefined
build:ubsan --per_file_copt=external/.*@-fno-sanitize=undefined
build:ubsan --per_file_copt=third_party/protos/etcd/.*@-fno-sanitize=undefined

# Combined ASan + UBSan policy:
#   - GCC and Clang explicitly support `-fsanitize=address,undefined` as a
#     single composition: the ASan runtime (libasan) already pulls in libubsan,
#     so the two sanitizers share interceptors and shadow-memory infrastructure.
#     TSan is mutually exclusive with both runtimes and CANNOT be combined here
#     (`-fsanitize=thread` + `-fsanitize=address` is rejected by the compiler).
#   - Flag placement (`--copt` vs `--cxxopt`) intentionally mirrors the
#     standalone `build:asan` and `build:ubsan` blocks above:
#       * ASan-derived flags (`-fsanitize=address,undefined`, `-fno-omit-frame-pointer`,
#         `-g3`) use `--copt` so they reach BOTH C and C++ compile actions.
#         This is required because several third-party deps compile real C
#         sources via `cc_library` (zlib's 15 `.c` files in third_party/zlib.BUILD,
#         securec's `glob src/*.c`, libcurl's `glob lib/**/*.c`, ZeroMQ's
#         `external/sha1/*.c`). Using `--cxxopt` here would silently drop ASan
#         instrumentation on those C files, a regression vs `--config=asan`.
#       * UBSan-specific tuning flags (`-fno-sanitize=alignment`,
#         `-fsanitize=float-cast-overflow`, `-fno-sanitize-recover=all`, `-O0`)
#         keep `--cxxopt` to match `build:ubsan` and because UBSan is disabled
#         on external repos anyway via `--per_file_copt` below.
#   - All UBSan sub-check tuning from `build:ubsan` above applies verbatim:
#     `-fno-sanitize=alignment` (third-party aligned-but-not-declared-aligned
#     false positives), `-fsanitize=float-cast-overflow`, `-fno-sanitize-recover=all`
#     (halt on first UB), `-O0` (no optimisation-dependent UB elision), and the
#     `--per_file_copt` third-party / etcd-stub exclusions (GCC 14 + absl
#     raw_hash_set constexpr workaround and `typeinfo for grpc::internal::
#     ClientReactor` link workaround). The `--per_file_copt=external/.*@
#     -fno-sanitize=undefined` only removes the `undefined` sub-check group
#     (it does NOT remove `address`), so external C/C++ files keep ASan
#     instrumentation while UBSan is disabled on them.
#   - `--define=asan=1` is set so `config_setting(name = "is_asan")` in the
#     root BUILD.bazel matches: any `select()` that skips or adjusts behavior
#     under ASan (e.g. tests tagged `noasan`) activates correctly. There is no
#     equivalent `is_ubsan` config setting today, so combined mode is treated
#     as ASan for select() purposes, which is the conservative choice.
#   - `test:asan_ubsan` mirrors `test:asan` runtime env tuning: ASan's
#     detect_leaks / detect_odr_violation defaults are reduced because the
#     brpc / bthread third-party init paths trip them; LSAN is also disabled
#     because the worker's background threads hold allocations whose lifetime
#     outlives the test process.
build:asan_ubsan --copt=-fsanitize=address,undefined
build:asan_ubsan --copt=-fno-omit-frame-pointer
build:asan_ubsan --copt=-g3
build:asan_ubsan --cxxopt=-fno-sanitize=alignment
build:asan_ubsan --cxxopt=-fsanitize=float-cast-overflow
build:asan_ubsan --cxxopt=-fno-sanitize-recover=all
build:asan_ubsan --cxxopt=-O0
build:asan_ubsan --linkopt=-fsanitize=address,undefined
build:asan_ubsan --define=asan=1
build:asan_ubsan --per_file_copt=external/.*@-fno-sanitize=undefined
build:asan_ubsan --per_file_copt=third_party/protos/etcd/.*@-fno-sanitize=undefined
# Same brpc bthread/context.cpp ASan workaround as in `build:asan` above:
# the file is pure inline assembly, and on aarch64 + ASan its module-init
# constructor's relocation lands in a discarded section and breaks the
# link of `datasystem_coordinator` / `datasystem_worker` and the
# `@@datasystem_sdk_validation//bazel/sdk:client_build_validation` target.
# The `-fno-sanitize=undefined` per_file_copt above already removes UBSan
# from this file (as part of `external/.*`); we additionally remove ASan
# here so the combined ASan+UBSan mode does not regress vs standalone ASan.
# The broad regex `external/.*bthread/context\.cpp` is required to cover
# both `@com_github_apache_brpc` (main build) and `@ds_brpc` (SDK
# validation repo_mapping); see the comment in `build:asan` above for the
# full rationale.
build:asan_ubsan --per_file_copt=external/.*bthread/context\.cpp@-fno-sanitize=address
test:asan_ubsan --test_env=ASAN_OPTIONS=detect_leaks=0:detect_odr_violation=0
test:asan_ubsan --test_env=LSAN_OPTIONS=detect_leaks=0

build:coverage --cxxopt=-fprofile-arcs --cxxopt=-ftest-coverage
build:coverage --linkopt=-fprofile-arcs --linkopt=-ftest-coverage --linkopt=-lgcov
build:coverage --cxxopt=-DBUILD_COVERAGE

build --cxxopt=-UENABLE_PERF
build:perf --cxxopt=-DENABLE_PERF
build:hetero --cxxopt=-DBUILD_HETERO

build --copt="-Wno-error"
build --copt="-Wno-missing-field-initializers"
build --host_copt="-Wno-missing-field-initializers"
build --copt="-w"

build --action_env=CC=gcc
build --action_env=CXX=g++
build --action_env=DS_JEMALLOC_LG_PAGE
common --enable_bzlmod=false
# Disable brpc's process-wide pthread mutex symbol interposition.
build --define=BRPC_WITH_NO_PTHREAD_MUTEX_HOOK=true
build --define=grpc_no_xds=true
build --define=grpc_no_binder=true
build --define=grpc_no_ares=true
build --per_file_copt=external/.*@-Wno-error

build:py39 --@rules_python//python/config_settings:python_version=3.9
build:py310 --@rules_python//python/config_settings:python_version=3.10
build:py311 --@rules_python//python/config_settings:python_version=3.11
build:py312 --@rules_python//python/config_settings:python_version=3.12
build:py313 --@rules_python//python/config_settings:python_version=3.13

build:test --define=with_tests=true
build:test --cxxopt=-DWITH_TESTS
test --define=with_tests=true
test --cxxopt=-DWITH_TESTS
