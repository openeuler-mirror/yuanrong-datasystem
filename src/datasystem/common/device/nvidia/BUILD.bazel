load("//bazel:build_defs.bzl", "ds_cc_library")

package(default_visibility = ["//src/datasystem:__subpackages__"])

ds_cc_library(
    name = "cuda_host_memory",
    srcs = ["cuda_host_memory.cpp"],
    hdrs = ["cuda_host_memory.h"],
    linkopts = ["-ldl"],
    deps = [
        "//include/datasystem/utils:utils_headers",
        "//src/datasystem/common/util:status_helper",
    ] + select({
        # Default wheel must not fetch @local_cuda. Headers are only needed when
        # Pipeline H2D already pulls the toolkit; otherwise __has_include compiles a no-op.
        "//:enable_pipeline_h2d": ["@local_cuda//:cuda_headers"],
        "//conditions:default": [],
    }),
)

ds_cc_library(
    name = "cuda_resource_manager",
    srcs = [
        "cuda_resource_manager.cpp",
    ],
    hdrs = [
        "cuda_resource_manager.h",
    ],
    deps = [
        "//src/datasystem/common/device:device_batch_copy_helper",
        "//src/datasystem/common/device:device_manager_factory",
        "//src/datasystem/common/device:device_resource_manager",
        "//src/datasystem/common/flags:ds_flags",
        "//src/datasystem/common/perf:common_perf",
        "//src/datasystem/common/util:format",
        "//src/datasystem/common/util:status_helper",
    ],
)
