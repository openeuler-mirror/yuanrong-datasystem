    args = [
        "$(location //src/datasystem/worker:datasystem_worker)",
        "$(location //:libjemalloc_shared_file)",
    ],
    data = [
        "//:libjemalloc_shared_file",
        "//src/datasystem/worker:datasystem_worker",
