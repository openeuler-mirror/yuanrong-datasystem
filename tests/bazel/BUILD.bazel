        "//:enable_jemalloc_prof": ["EXPECT_JEMALLOC_PROF"],
        "//conditions:default": [],
    }),
    tags = ["manual"],
    deps = select({
        "//:enable_jemalloc_prof": ["@jemalloc_kvc//:jemalloc_prof_shared"],
        "//conditions:default": ["@jemalloc_kvc//:jemalloc_shared"],
    }),
