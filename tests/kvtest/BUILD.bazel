# Bazel build for the standalone kvtest KVClient performance tool.
#
# Mirrors tests/kvtest/CMakeLists.txt. Unlike the CMake flow (which links
# against a pre-installed SDK at $DATASYSTEM_SDK_DIR), the Bazel flow builds
# the in-tree datasystem client library as part of the graph and produces a
# self-contained kvtest binary. This matches example/cpp/BUILD.bazel.
#
# The kvtest binary therefore does NOT need libdatasystem.so at runtime; the
# Makefile `package` step tolerates a missing third_party/sdk/ for this mode.
#
# Build:
#   cd <repo root> && bazel build //tests/kvtest:kvtest
# or via build.sh:
#   cd tests/kvtest && bash build.sh -b bazel

load("@com_google_protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")

package(default_visibility = ["//visibility:public"])

# kvtest control-plane proto (Notify/Stats/Stop/Summary). strip_import_prefix
# (mirrors src/datasystem/protos PROTO_ROOT usage) makes the generated
# kvtest_control.pb.h includable by basename via the cc_proto_library's virtual
# includes; without it the dep does not propagate the header include path.
proto_library(
    name = "kvtest_control_proto",
    srcs = ["kvtest_control.proto"],
    strip_import_prefix = "/tests/kvtest",
)

cc_proto_library(
    name = "kvtest_control_cc_proto",
    deps = [":kvtest_control_proto"],
)

# NUMA support is opt-in via --define=kvtest_numa=true. build.sh enables it
# only when both <numa.h> and libnuma.so are detected, keeping the link in
# sync with cpu_affinity.h's __has_include(<numa.h>) auto-detection.
config_setting(
    name = "with_numa",
    values = {"define": "kvtest_numa=true"},
)

# Embed BUILD_VERSION (from VERSION) and BUILD_COMMIT (from git) at compile
# time, matching the CMake add_definitions() path. Values are taken from the
# KVTEST_BUILD_VERSION / KVTEST_BUILD_COMMIT action env vars when set by
# build.sh (which can run git in the real workspace); otherwise falls back to
# the VERSION file and "unknown" so a standalone `bazel build` still works.
#
# Consumed via src/main.cpp's `__has_include("build_info.h")` guard, the same
# pattern the SDK uses for src/datasystem/common/util/version.h vs the
# generated git_version_def.h. This keeps CMake (-D defines) and Bazel
# (generated header) on consistent, source-side-conditional ground.
genrule(
    name = "build_info_gen",
    srcs = ["VERSION"],
    outs = ["src/build_info.h"],
    cmd = "V=$${KVTEST_BUILD_VERSION:-$$(tr -d '\\n' < $(location VERSION))}; " +
          "C=$${KVTEST_BUILD_COMMIT:-unknown}; " +
          "{ printf '#define BUILD_VERSION \"%s\"\\n' \"$$V\"; " +
          "printf '#define BUILD_COMMIT \"%s\"\\n' \"$$C\"; } > $@",
)

# Wraps :build_info_gen so cc_binary targets (coordinator_test, worker_test)
# can depend on it for the build_info.h include path. genrule outputs cannot
# be listed directly in cc_binary deps because they lack CcInfo.
cc_library(
    name = "build_info",
    hdrs = [":build_info_gen"],
    strip_include_prefix = "src",
)

# kvtest sources compiled as a library so the generated build_info.h (listed in
# hdrs like //src/datasystem/common/util:common_util_impl lists :git_version_def)
# is on the include path for the #include in main.cpp. alwayslink ensures every
# translation unit (and any static initializers) lands in the final binary.
#
# strip_include_prefix = "src" makes src/common/config.h includable as
# "common/config.h" and src/build_info.h as "build_info.h", matching the
# CMake target_include_directories(... src) layout and main.cpp's includes.
#
# KVTEST_USE_BRPC selects the brpc control plane (BrpcControlServer + brpc peer
# client) over the httplib one. The CMake build does not define this symbol and
# keeps the httplib path; brpc headers/libs are not shipped in the SDK, so the
# cmake mode cannot use brpc until the SDK packages third-party dev headers.
cc_library(
    name = "kvtest_lib",
    srcs = [
        "src/common/config.cpp",
        "src/metrics/metrics.cpp",
        "src/pipeline/pipeline.cpp",
        "src/pipeline/kv_worker.cpp",
        "src/pipeline/cache_reader.cpp",
        "src/pipeline/stop.cpp",
        "src/rpc/http_server.cpp",
        "src/rpc/notify_dispatcher.cpp",
        "src/rpc/brpc_server.cpp",
        "src/rpc/peer_client.cpp",
        "src/benchmark/benchmark_runner.cpp",
    ],
    hdrs = [
        "src/common/config.h",
        "src/common/jf_service_discovery.h",
        "src/common/simple_log.h",
        "src/common/bthread_compat.h",
        "src/common/thread_pool.h",
        "src/common/cpu_affinity.h",
        "src/metrics/metrics.h",
        "src/vendor/TDigest.h",
        "src/pipeline/pipeline.h",
        "src/pipeline/kv_worker.h",
        "src/pipeline/cache_reader.h",
        "src/pipeline/data_pattern.h",
        "src/pipeline/stop.h",
        "src/rpc/http_server.h",
        "src/rpc/notify_dispatcher.h",
        "src/rpc/brpc_server.h",
        "src/rpc/peer_client.h",
        "src/benchmark/benchmark_runner.h",
        "src/benchmark/kv_client_adapter.h",
        "src/benchmark/subprocess.h",
        "src/vendor/httplib.h",
        "src/vendor/nlohmann_json.hpp",
        ":build_info_gen",
    ],
    # `src/` is the include root for kvtest's own headers (e.g. "common/config.h",
    # "vendor/httplib.h"), matching CMake target_include_directories(... src).
    strip_include_prefix = "src",
    copts = [
        "-Wno-sign-compare",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
    ],
    # Brpc control plane replaces httplib in bazel mode. main.cpp / kv_worker.cpp
    # / stop.cpp select impls behind this define; httplib stays the cmake path.
    defines = ["KVTEST_USE_BRPC"],
    # Statically link libstdc++/libgcc so the binary runs on older GCC hosts
    # (e.g. openEuler 22.04 with GCC 10), matching CMake target_link_options.
    linkopts = select({
        ":with_numa": ["-lnuma"],
        "//conditions:default": [],
    }) + [
        "-static-libstdc++",
        "-static-libgcc",
        "-pthread",
    ],
    alwayslink = True,
    deps = [
        # Provides KVClient, ServiceDiscovery (transitively alwayslinked via
        # :object_cache:object_client -> :service_discovery), and the public
        # datasystem headers.
        "//src/datasystem/client:datasystem",
        "//include/datasystem:headers",
        # kvtest control-plane proto (Notify/Stats/Stop/Summary).
        ":kvtest_control_cc_proto",
        # brpc server runtime for the bazel-mode control plane. Already pulled
        # transitively by the datasystem client, but listed explicitly because
        # brpc_server.cpp / peer_client.cpp use brpc::Server / brpc::Channel
        # directly.
        "@com_github_apache_brpc//:brpc",
        # gflags is a runtime dep of brpc; link explicitly so the brpc server's
        # internal flags resolve at load time.
        "@com_github_gflags_gflags//:gflags",
        # Direct use of google::protobuf::Service / DescriptorPool in
        # brpc_server.cpp (protobuf 28.x generic-service dispatch).
        "@com_google_protobuf//:protobuf",
    ],
)

cc_binary(
    name = "kvtest",
    srcs = ["src/main.cpp"],
    deps = [":kvtest_lib"],
)

# JF client library (header-only, shared by coordinator_test and worker_test)
cc_library(
    name = "jf_lib",
    hdrs = [
        "src/common/jf_service_discovery.h",
        "src/vendor/httplib.h",
        "src/vendor/nlohmann_json.hpp",
    ],
    strip_include_prefix = "src",
    deps = [
        "//include/datasystem:headers",
    ],
)

# Coordinator standalone deployment test program
cc_binary(
    name = "coordinator_test",
    srcs = ["src/coordinator_main.cpp"],
    deps = [
        ":jf_lib",
        ":build_info",
        "//src/datasystem/coordinator:coordinator_server",
        "//include/datasystem:headers",
        "//src/datasystem/common/flags:dynamic_flag_config",
        "//src/datasystem/common/log:common_log",
        "//src/datasystem/common/util:uuid_generator",
    ],
)

# Worker standalone deployment test program
cc_binary(
    name = "worker_test",
    srcs = ["src/data_worker_main.cpp"],
    deps = [
        ":jf_lib",
        ":build_info",
        "//src/datasystem/worker:worker",
        "//src/datasystem/worker:add_miss_libs_fixme",
        "//include/datasystem:headers",
        "//src/datasystem/common/flags:ds_flags",
        "//src/datasystem/common/log:common_log",
        "//src/datasystem/common/util:request_context",
    ],
)
