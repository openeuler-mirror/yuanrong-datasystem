"""Unit tests for the CANN-independent HIXL plugin ABI."""

load("//bazel:build_defs.bzl", "ds_cc_test")

package(default_visibility = ["//visibility:public"])

ds_cc_test(
    name = "urma_log_test",
    srcs = ["urma_log_test.cpp"],
    defines = ["USE_URMA", "USE_URMA_MOCK"],
    target_compatible_with = select({
        "//:enable_urma_mock": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//src/datasystem/common/log:common_log",
        "//src/datasystem/common/rdma:urma_manager",
        "//src/datasystem/common/urma_mock:urma_abi_compat",
        "//src/datasystem/common/util:file_util",
        "//tests/support/datasystem/common/urma_mock:urma_mock_backend",
    ],
)

ds_cc_test(
    name = "urma_orphan_sweep_test",
    srcs = ["urma_orphan_sweep_test.cpp"],
    defines = ["USE_URMA", "USE_URMA_MOCK"],
    target_compatible_with = select({
        "//:enable_urma_mock": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//src/datasystem/common/inject:common_inject",
        "//src/datasystem/common/rdma:urma_manager",
        "//src/datasystem/common/urma_mock:urma_abi_compat",
        "//tests/support/datasystem/common/urma_mock:urma_mock_backend",
    ],
)

URMA_COMPATIBLE_WITH = select({
    "//:enable_urma": [],
    "//:enable_urma_mock": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

ds_cc_test(
    name = "hixl_plugin_api_test",
    srcs = ["hixl_plugin_api_test.cpp"],
    deps = ["//src/datasystem/common/rdma/npu:hixl_plugin_api"],
)

ds_cc_test(
    name = "ub_port_health_test",
    srcs = ["ub_port_health_test.cpp"],
    deps = [
        "//src/datasystem/common/object_cache:ub_port_health",
        "//tests/ut:ut_common",
    ],
)

ds_cc_test(
    name = "urma_port_status_provider_test",
    srcs = ["urma_port_status_provider_test.cpp"],
    defines = select({
        "//:enable_urma": ["USE_URMA"],
        "//:enable_urma_mock": ["USE_URMA", "USE_URMA_MOCK"],
        "//conditions:default": [],
    }),
    target_compatible_with = URMA_COMPATIBLE_WITH,
    deps = [
        "//src/datasystem/common/inject:common_inject",
        "//src/datasystem/common/object_cache:ub_port_health",
        "//src/datasystem/common/rdma:urma_dlopen_util",
    ] + select({
        "//:enable_urma": ["//src/datasystem/common/rdma:urma_manager"],
        "//:enable_urma_mock": [
            "//src/datasystem/common/rdma:urma_manager",
            "//src/datasystem/common/urma_mock:urma_abi_compat",
        ],
        "//conditions:default": [],
    }),
)
