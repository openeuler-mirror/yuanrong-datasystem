ds_cc_test(
    name = "stream_close_timeout_test",
    srcs = ["stream_close_timeout_test.cpp"],
    deps = [
        "//src/datasystem/common/rpc:brpc_stream_close_helper",
        "//src/datasystem/common/rpc/brpc:hello_cc_proto",
