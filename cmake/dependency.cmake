if(POLICY CMP0144)
    cmake_policy(SET CMP0144 NEW)
endif()
include(FindThreads)
set(_libraries absl re2 zlib libzmq jemalloc rocksdb securec tbb nlohmann_json openssl libcurl
    protobuf grpc etcdapi spdlog gflags leveldb brpc braft)
if (DS_BUILD_STATIC_SDK)
    list(REMOVE_ITEM _libraries rocksdb braft)
endif()
foreach(_library IN LISTS _libraries)
    include("${CMAKE_SOURCE_DIR}/cmake/external_libs/${_library}.cmake")
    if (DS_BUILD_STATIC_SDK)
        get_property(CMAKE_PREFIX_PATH GLOBAL PROPERTY DS_STATIC_SDK_PREFIXES)
    endif()
endforeach()

if (BUILD_WITH_URMA)
    message(STATUS "Build with urma")
    set(URMA_OVER_UB "ON")
    include(${CMAKE_SOURCE_DIR}/cmake/external_libs/urma.cmake)
endif()

if (BUILD_PIPLN_H2D)
    if (NOT BUILD_WITH_URMA AND NOT BUILD_WITH_URMA_MOCK)
        message(FATAL_ERROR "BUILD_PIPLN_H2D requires BUILD_WITH_URMA or BUILD_WITH_URMA_MOCK")
    endif()
    include(${CMAKE_SOURCE_DIR}/cmake/external_libs/pipeline_rh2d.cmake)
endif()

if (BUILD_WITH_URMA_MOCK)
    if (BUILD_WITH_URMA)
        message(FATAL_ERROR "BUILD_WITH_URMA_MOCK and BUILD_WITH_URMA are mutually exclusive (mock backend is for dev/CI without liburma.so)")
    endif()
    message(STATUS "Build with urma mock (local shm+UDS backend, no SDK needed)")
    add_compile_definitions(USE_URMA USE_URMA_MOCK)
endif()
if (BUILD_WITH_RDMA)
    include(${CMAKE_SOURCE_DIR}/cmake/external_libs/ucx.cmake)
endif()

if (BUILD_JAVA_API)
    include(${CMAKE_SOURCE_DIR}/cmake/external_libs/jni.cmake)
endif()

if (WITH_TESTS)
    include(${CMAKE_SOURCE_DIR}/cmake/external_libs/gtest.cmake)
endif()

if (BUILD_PYTHON_API)
    include(${CMAKE_SOURCE_DIR}/cmake/external_libs/pybind11.cmake)
endif()

if (BUILD_HETERO)
    if (BUILD_HETERO_NPU)
        include(${CMAKE_SOURCE_DIR}/cmake/external_libs/ascend.cmake)
        include(${CMAKE_SOURCE_DIR}/cmake/external_libs/p2phccl.cmake)
    endif()
    if (BUILD_HETERO_GPU)
        include(${CMAKE_SOURCE_DIR}/cmake/external_libs/cuda.cmake)
    endif()
endif()
