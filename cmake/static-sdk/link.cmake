# Use CMake's evaluated link order, including repeated archives needed for static cycles.
set(_reply "${_build}/.cmake/api/v1/reply")
file(GLOB _indices "${_reply}/index-*.json")
list(GET _indices -1 _index)
file(READ "${_index}" _json)
string(JSON _model GET "${_json}" reply codemodel-v2 jsonFile)
file(READ "${_reply}/${_model}" _json)
string(JSON _targets GET "${_json}" configurations 0 targets)
string(JSON _count LENGTH "${_targets}")
math(EXPR _last "${_count} - 1")
foreach(_i RANGE ${_last})
    string(JSON _name GET "${_targets}" ${_i} name)
    if (_name STREQUAL "ds_client_link_inputs")
        string(JSON _target GET "${_targets}" ${_i} jsonFile)
        break()
    endif()
endforeach()
file(READ "${_reply}/${_target}" _json)
string(JSON _fragments GET "${_json}" link commandFragments)
string(JSON _count LENGTH "${_fragments}")
math(EXPR _last "${_count} - 1")
file(STRINGS "${_build}/client-abi.txt" _abi)
set(_libraries)
set(_outputs)
foreach(_i RANGE ${_last})
    string(JSON _role GET "${_fragments}" ${_i} role)
    if (_role STREQUAL "libraries")
        string(JSON _fragment GET "${_fragments}" ${_i} fragment)
        separate_arguments(_items UNIX_COMMAND "${_fragment}")
        foreach(_item IN LISTS _items)
            if (_item MATCHES "[.]a$" AND NOT IS_ABSOLUTE "${_item}")
                get_filename_component(_item "${_item}" ABSOLUTE BASE_DIR "${_build}")
                list(APPEND _outputs "${_item}")
            endif()
            list(APPEND _libraries "${_item}")
        endforeach()
    endif()
endforeach()
list(REMOVE_DUPLICATES _outputs)
list(POP_FRONT _libraries _client)
